# Copy this file to config/wes/run.env and then replace the placeholder values.

OUTPUT_DIR="${CI_PROJECT_DIR:-$PWD}/output/wes"
WES_RESULTS_SUBDIR="results"
WES_LOGS_SUBDIR="logs"
WES_MODE="smoke"

SLURM_JOB_NAME="wes-family"
SLURM_PARTITION="CPU-64C256GB"
SLURM_QOS="qos_cpu_64c256gb"
SLURM_NODES="1"
SLURM_NTASKS="1"
SLURM_CPUS_PER_TASK="16"
SLURM_MEM="64G"
SLURM_TIME="24:00:00"

# If your cluster requires modules or conda, set it here.
SLURM_ENV_SETUP="source ~/.bashrc"

WES_SAMPLE_NAME="amd-family-smoke"
WES_FASTQ_DIR="/home/zhangmeigroup/luoxin23/upload20251105/fastq"
WES_SAMPLE_SHEET="${CI_PROJECT_DIR:-$PWD}/config/wes/samples.tsv"
WES_TEST_R1="/home/zhangmeigroup/luoxin23/upload20251105/fastq/2103022S1OWC_S12_R1_001.fastq.gz"
WES_TEST_R2="/home/zhangmeigroup/luoxin23/upload20251105/fastq/2103022S1OWC_S12_R2_001.fastq.gz"
WES_INSTALL_SMOKE="1"
WES_CONDA_CHANNELS="conda-forge bioconda"
WES_CONDA_PACKAGES="bwa bcftools gatk4 fastqc"

# Recommended first choice: official GRCh38 / hg38 primary assembly fasta.
WES_REF_PATH="/path/to/Homo_sapiens_assembly38.fasta"
WES_BED_PATH="/path/to/exome_targets.bed"
WES_KNOWN_SITES_VCF="/path/to/Homo_sapiens_assembly38.known_sites.vcf.gz"
VEP_CACHE_DIR="/path/to/vep/cache"

# GitLab / slurm-job.sh uses this command string directly when WES_MODE=pipeline.
WES_PIPELINE_CMD="bash pipelines/wes-germline.sh --sample-sheet \"$WES_SAMPLE_SHEET\" --out \"$OUTPUT_DIR/$WES_RESULTS_SUBDIR\" --ref \"$WES_REF_PATH\" --bed \"$WES_BED_PATH\" --known-sites \"$WES_KNOWN_SITES_VCF\" --threads \"$SLURM_CPUS_PER_TASK\" --vep-cache-dir \"$VEP_CACHE_DIR\""
