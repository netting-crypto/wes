# Copy to config/wes/resources.env and edit the values you really use.
#
# The safest workflow is:
# 1. First inspect the server to see whether these resources already exist.
# 2. If a resource is missing, then fill in its URL and run prepare-wes-resources.sh.

WES_RESOURCE_BASE="/home/zhangmeigroup/luoxin23/resources/hg38"

# Official / primary-source references
# GATK resource bundle overview:
# https://gatk.broadinstitute.org/hc/en-us/articles/360035889631-Where-can-I-find-known-variants-training-and-truth-sets-and-other-resource-files
# Human reference build notes:
# https://gatk.broadinstitute.org/hc/en-us/articles/360035890951-Human-genome-reference-builds-GRCh38-or-hg38-b37-hg19
# VEP cache docs:
# https://www.ensembl.org/info/docs/tools/vep/script/vep_cache.html

# Default reference URL below uses the NCBI GRCh38 no-alt analysis set in gzip
# form. prepare-wes-resources.sh will decompress it into the expected FASTA path.
REF_URL="https://ftp.ncbi.nlm.nih.gov/genomes/all/GCA/000/001/405/GCA_000001405.15_GRCh38/seqs_for_alignment_pipelines.ucsc_ids/GCA_000001405.15_GRCh38_no_alt_analysis_set.fna.gz"
DBSNP_URL="https://storage.googleapis.com/genomics-public-data/resources/broad/hg38/v0/Homo_sapiens_assembly38.dbsnp138.vcf"
KNOWN_INDELS_URL="https://storage.googleapis.com/genomics-public-data/resources/broad/hg38/v0/Homo_sapiens_assembly38.known_indels.vcf.gz"
MILLS_URL="https://storage.googleapis.com/genomics-public-data/resources/broad/hg38/v0/Mills_and_1000G_gold_standard.indels.hg38.vcf.gz"
BED_URL=""
GENCODE_GTF_URL="https://ftp.ebi.ac.uk/pub/databases/gencode/Gencode_human/release_48/gencode.v48.basic.annotation.gtf.gz"
WES_BED_PADDING_BP="50"
VEP_CACHE_URL=""

# After preparation, these are the paths you should point your pipeline at.
WES_REF_PATH="$WES_RESOURCE_BASE/reference/Homo_sapiens_assembly38.fasta"
WES_BED_PATH="$WES_RESOURCE_BASE/targets/exome_targets.bed"

# For first-pass BQSR we use Broad hg38 bundle style known-sites.
# The pipeline can start without them if you add --skip-bqsr for smoke tests.
WES_DBSNP_PATH="$WES_RESOURCE_BASE/known-sites/Homo_sapiens_assembly38.dbsnp138.vcf"
WES_KNOWN_INDELS_PATH="$WES_RESOURCE_BASE/known-sites/Homo_sapiens_assembly38.known_indels.vcf.gz"
WES_MILLS_PATH="$WES_RESOURCE_BASE/known-sites/Mills_and_1000G_gold_standard.indels.hg38.vcf.gz"

# Pass all Broad-style known-sites files into BQSR when they are available.
WES_KNOWN_SITES_1="$WES_DBSNP_PATH"
WES_KNOWN_SITES_2="$WES_KNOWN_INDELS_PATH"
WES_KNOWN_SITES_3="$WES_MILLS_PATH"

# Set this to 1 for the first pass if reference download works but known-sites
# still need to be sourced from an existing server copy or another mirror.
WES_ALLOW_MISSING_KNOWN_SITES="1"

VEP_CACHE_DIR="$WES_RESOURCE_BASE/vep/cache"
